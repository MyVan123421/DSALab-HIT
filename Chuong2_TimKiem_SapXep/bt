#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Nhap so phan tu: ";
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }

    int sum = 0;
    int minVal = a[0];
    int maxVal = a[0];

    for (int i = 0; i < n; i++) {
        sum += a[i];

        if (a[i] < minVal)
            minVal = a[i];

        if (a[i] > maxVal)
            maxVal = a[i];
    }

    float avg = (float)sum / n;

    cout << "\nTong = " << sum;
    cout << "\nMin = " << minVal;
    cout << "\nMax = " << maxVal;
    cout << "\nTrung binh = " << avg;

    return 0;
}
